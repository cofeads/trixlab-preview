<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>
      {{ page_title }}
      {% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}
      {% if current_page != 1 %} – {{ 'general.page' | t: number: current_page }}{% endif %}
      {% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {{ content_for_header }}
    <style>
      :root {
        --tp-bg: {{ settings.color_background }};
        --tp-surface: {{ settings.color_surface }};
        --tp-text: {{ settings.color_text }};
        --tp-muted: {{ settings.color_muted }};
        --tp-line: {{ settings.color_border }};
        --tp-accent: {{ settings.color_accent }};
        --tp-max: 1480px;
        --tp-radius: 22px;
        --tp-font: Arial, Helvetica, sans-serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--tp-bg); color: var(--tp-text); font-family: var(--tp-font); -webkit-font-smoothing: antialiased; }
      body.tp-lock { overflow: hidden; }
      img, svg { display: block; max-width: 100%; }
      button, input, select, textarea { font: inherit; }
      button, a { -webkit-tap-highlight-color: transparent; }
      a { color: inherit; text-decoration: none; }
      button { color: inherit; }
      .tp-container { width: min(calc(100% - 40px), var(--tp-max)); margin-inline: auto; }
      .tp-sr-only { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
      .tp-button { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 26px; border: 1px solid var(--tp-text); border-radius: 999px; background: var(--tp-text); color: var(--tp-bg); font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; transition: transform .2s ease, background .2s ease, color .2s ease; }
      .tp-button:hover { transform: translateY(-2px); }
      .tp-button--outline { background: transparent; color: var(--tp-text); }
      .tp-button--accent { border-color: var(--tp-accent); background: var(--tp-accent); color: #0b0d0c; }
      .tp-kicker { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 18px; color: var(--tp-accent); font-size: 12px; font-weight: 900; letter-spacing: .18em; text-transform: uppercase; }
      .tp-kicker::before { width: 28px; height: 2px; background: currentColor; content: ""; }
      .tp-heading { margin: 0; font-size: clamp(42px, 6vw, 92px); line-height: .9; letter-spacing: -.065em; text-transform: uppercase; }
      .tp-section { padding: 108px 0; }
      .tp-section-head { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 48px; }
      .tp-section-head h2 { max-width: 900px; margin: 0; font-size: clamp(36px, 5vw, 72px); line-height: .94; letter-spacing: -.055em; text-transform: uppercase; }
      .tp-section-head p { max-width: 520px; margin: 0; color: var(--tp-muted); line-height: 1.65; }
      .tp-grid { display: grid; gap: 18px; }
      .tp-card { border: 1px solid var(--tp-line); border-radius: var(--tp-radius); background: var(--tp-surface); overflow: hidden; }
      .tp-link-arrow { display: inline-flex; align-items: center; gap: 14px; font-size: 12px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
      .tp-link-arrow span { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid currentColor; border-radius: 50%; transition: transform .2s ease; }
      .tp-link-arrow:hover span { transform: translateX(4px); }
      .shopify-section { position: relative; }
      @media (max-width: 900px) {
        .tp-container { width: min(calc(100% - 28px), var(--tp-max)); }
        .tp-section { padding: 72px 0; }
        .tp-section-head { display: grid; margin-bottom: 34px; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
      }
    </style>
  </head>
  <body>
    <a class="tp-sr-only" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% section 'announcement-bar' %}
    {% section 'site-header' %}
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
    {% section 'site-footer' %}
  </body>
</html>
