<section class="tp-section tp-page">
  <div class="tp-container">
    <h1 class="tp-heading">{{ page.title }}</h1>
    <div class="tp-page__content">{{ page.content }}</div>
  </div>
</section>

{% stylesheet %}
  .tp-page { min-height: 65svh; }
  .tp-page__content { max-width: 900px; margin: 54px auto 0; color: var(--tp-muted); font-size: 17px; line-height: 1.75; }
  .tp-page__content h2, .tp-page__content h3 { color: var(--tp-text); line-height: 1.05; }
  .tp-page__content img { border-radius: var(--tp-radius); }
{% endstylesheet %}

{% schema %}
{
  "name": "Main page",
  "settings": []
}
{% endschema %}
