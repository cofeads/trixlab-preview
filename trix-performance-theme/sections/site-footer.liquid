<footer class="tp-footer">
  <div class="tp-container">
    <div class="tp-footer__top">
      <div>
        {% render 'brand-logo', class: 'tp-footer__logo', variant: 'full' %}
        <p>{{ section.settings.tagline }}</p>
      </div>
      <div class="tp-footer__newsletter">
        <span>{{ section.settings.newsletter_kicker }}</span>
        <h2>{{ section.settings.newsletter_title }}</h2>
        {% form 'customer', class: 'tp-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="tp-sr-only" for="FooterEmail-{{ section.id }}">{{ 'general.newsletter_email' | t }}</label>
          <input id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ 'general.newsletter_email' | t }}" required>
          <button type="submit">{{ 'general.newsletter_submit' | t }} →</button>
        {% endform %}
      </div>
    </div>
    <div class="tp-footer__links">
      <nav aria-label="Footer">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      <div>
        {% if settings.social_instagram != blank %}<a href="{{ settings.social_instagram }}">Instagram</a>{% endif %}
        {% if settings.social_tiktok != blank %}<a href="{{ settings.social_tiktok }}">TikTok</a>{% endif %}
        {% if settings.social_youtube != blank %}<a href="{{ settings.social_youtube }}">YouTube</a>{% endif %}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .tp-footer { padding: 90px 0 28px; border-top: 1px solid var(--tp-line); background: #080a09; }
  .tp-footer__top { display: grid; grid-template-columns: .8fr 1.2fr; gap: 100px; padding-bottom: 80px; }
  .tp-footer__logo { width: min(440px, 100%); }
  .tp-footer__top > div:first-child p { max-width: 410px; margin: 30px 0 0; color: var(--tp-muted); line-height: 1.65; }
  .tp-footer__newsletter span { color: var(--tp-accent); font-size: 10px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  .tp-footer__newsletter h2 { margin: 14px 0 30px; font-size: clamp(34px, 5vw, 68px); line-height: .95; letter-spacing: -.05em; text-transform: uppercase; }
  .tp-footer__form { display: flex; border-bottom: 1px solid var(--tp-text); }
  .tp-footer__form input { flex: 1; min-width: 0; padding: 18px 0; border: 0; outline: 0; background: transparent; color: var(--tp-text); }
  .tp-footer__form button { border: 0; background: transparent; color: var(--tp-accent); font-size: 11px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; cursor: pointer; }
  .tp-footer__links { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 30px; padding-top: 28px; border-top: 1px solid var(--tp-line); color: var(--tp-muted); font-size: 10px; letter-spacing: .09em; text-transform: uppercase; }
  .tp-footer__links nav, .tp-footer__links > div { display: flex; gap: 20px; }
  .tp-footer__links > div { justify-content: end; }
  @media (max-width: 760px) {
    .tp-footer { padding-top: 64px; }
    .tp-footer__top { grid-template-columns: 1fr; gap: 52px; padding-bottom: 56px; }
    .tp-footer__links { grid-template-columns: 1fr; }
    .tp-footer__links nav, .tp-footer__links > div { flex-wrap: wrap; justify-content: start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Custom powersports wraps engineered for hard riding, clean fitment and a look that is unmistakably yours."
    },
    {
      "type": "text",
      "id": "newsletter_kicker",
      "label": "Newsletter kicker",
      "default": "GET FIRST ACCESS"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter title",
      "default": "NEW DROPS. NEW MATERIALS. NO STOCK LOOKS."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu"
    }
  ]
}
{% endschema %}
